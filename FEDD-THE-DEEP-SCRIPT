local function usesMineScript(plr)
	if not plr or not plr.Parent then
		return false
	end
	if plr:GetAttribute(SCRIPT_USER_ATTR) == true then
		return true
	end
	local pg = plr:FindFirstChild("PlayerGui")
	if pg and pg:FindFirstChild("GalaxyAutoFarmLoopEquipGui") then
		return true
	end
	return false
end

local function refreshPlayerList()
	for _, child in ipairs(playerListFrame:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	local list = Players:GetPlayers()
	local totalHeight = 0
	for _, plr in ipairs(list) do
		if plr ~= player and usesMineScript(plr) then
			local itemBtn = Instance.new("TextButton")
			itemBtn.Size = UDim2.new(1, -8, 0, 26)
			itemBtn.BackgroundColor3 = (selectedTargetPlayer == plr) and COL_ACCENT or COL_CARD_DARK
			itemBtn.TextColor3 = COL_TEXT
			itemBtn.Font = Enum.Font.Code
			itemBtn.TextSize = 11
			itemBtn.Text = plr.Name
			itemBtn.BorderSizePixel = 0
			itemBtn.ZIndex = 6
			itemBtn.Parent = playerListFrame
			Instance.new("UICorner", itemBtn).CornerRadius = UDim.new(0, 6)

			itemBtn.MouseButton1Click:Connect(function()
				selectedTargetPlayer = plr
				selectedUserLabel.Text = "MineScript Target: " .. plr.Name
				refreshPlayerList()
			end)

			totalHeight += 30
		end
	end

	if totalHeight == 0 then
		selectedTargetPlayer = nil
		selectedUserLabel.Text = "MineScript Target: None"
	end

	playerListFrame.CanvasSize = UDim2.new(0, 0, 0, totalHeight)
end

