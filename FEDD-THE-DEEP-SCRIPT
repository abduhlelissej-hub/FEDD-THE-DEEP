startBtn.MouseButton1Click:Connect(function()
	if isRunning then
		stopFarmLoop("Stopped")
		return
	end

	local char = player.Character
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not (humanoid and root) then return end

	runToken += 1
	local currentToken = runToken
	isRunning = true
	startBtn.Text = "Stop"
	startBtn.BackgroundColor3 = COL_ACCENT_PINK

	task.spawn(function()
		local didInitialTeleport = false
		repeat
			if not isRunning or currentToken ~= runToken then break end

			char = player.Character
			humanoid = char and char:FindFirstChildOfClass("Humanoid")
			root = char and char:FindFirstChild("HumanoidRootPart")
			if not (humanoid and root) then break end

			if not didInitialTeleport then
				didInitialTeleport = true
				statusLabel.Text = "Teleported • Walking 5 extra steps"
				root.CFrame = CFrame.new(TARGET_POSITION + Vector3.new(0, 2.5, 0))
				task.wait(0.1)
			else
				statusLabel.Text = "Walking 5 extra steps"
			end

			local lookFlat = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
			local stepDir = lookFlat.Magnitude > 0.05 and lookFlat.Unit or Vector3.new(0, 0, -1)
			local extraGoal = root.Position + (stepDir * (EXTRA_STEPS * STEP_SIZE))
			humanoid:MoveTo(extraGoal)

			local timerStart = os.clock()
			while isRunning and currentToken == runToken do
				if (os.clock() - timerStart) >= WAIT_TIME then
					break
				end
				RunService.RenderStepped:Wait()
			end
			if not isRunning or currentToken ~= runToken then break end

			statusLabel.Text = "Action 1"
			tapScreen()

			local waitStart = os.clock()
			while isRunning and currentToken == runToken do
				if (os.clock() - waitStart) >= SECOND_WAIT_TIME then
					break
				end
				RunService.RenderStepped:Wait()
			end
			if not isRunning or currentToken ~= runToken then break end

			statusLabel.Text = "Action 2"
			tapScreen()

			if isLooping then
				task.wait(0.5)
			end
		until not isLooping or not isRunning or currentToken ~= runToken

		if currentToken == runToken then
			stopFarmLoop(isLooping and "Loop finished" or "Ready")
		end
	end)
end)

