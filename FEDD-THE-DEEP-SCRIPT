local function switchTab(tabName)
	if tabName == "ADMIN" and not isAdminRole(currentRole) then
		tabName = "HOME"
	end

	currentTab = tabName
	homePage.Visible = (tabName == "HOME")
	farmPage.Visible = (tabName == "FARM")
	adminPage.Visible = (tabName == "ADMIN")

	if tabName == "HOME" then
		topTitle.Text = "Home"
	elseif tabName == "FARM" then
		topTitle.Text = "Farm"
	else
		topTitle.Text = "Admin"
		refreshPlayerList()
	end

	local barY = (tabName == "HOME" and 0.06) or (tabName == "FARM" and 0.19) or 0.32
	TweenService:Create(activeBar, TweenInfo.new(0.15), {
		Position = UDim2.new(0, 0, barY, 0)
	}):Play()

	navHomeBtn.BackgroundColor3 = (tabName == "HOME") and COL_CARD or COL_SIDEBAR
	navHomeBtn.TextColor3 = (tabName == "HOME") and COL_TEXT or COL_MUTED

