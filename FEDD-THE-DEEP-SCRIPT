local function getCurrentHwid()
	local hwid = ""
	pcall(function()
		hwid = tostring(RbxAnalyticsService:GetClientId() or "")
	end)
	if hwid == "" then
		hwid = "CLIENT_" .. tostring(player.UserId)
	end
	return hwid
end

local CURRENT_HWID = getCurrentHwid()

local function loadHwidMap()
	local map = {}
	pcall(function()
		if getgenv then
			local env = getgenv()
			if type(env._GLX_HWID_MAP) == "table" then
				for k, v in pairs(env._GLX_HWID_MAP) do
					map[k] = v
				end
			end
		end
	end)
	pcall(function()
		if isfile and readfile and isfile(HWID_FILE) then
			local raw = readfile(HWID_FILE)
			if type(raw) == "string" and raw ~= "" then
				for line in string.gmatch(raw, "[^\r\n]+") do
					local h, keyVal = string.match(line, "^([^=]+)=(.+)$")
					if h and keyVal then
						map[h] = keyVal
					end
				end
			end
		end
	end)
	return map
end

local function writeHwidMap(map)
	pcall(function()
		if getgenv then
			local env = getgenv()
			env._GLX_HWID_MAP = map
		end
	end)
	pcall(function()
		if writefile then
			local lines = {}
			for h, k in pairs(map) do
				table.insert(lines, h .. "=" .. k)
			end
			writefile(HWID_FILE, table.concat(lines, "\n"))
		end
	end)
end

local function saveHwidKey(hwid, keyStr)
	local map = loadHwidMap()
	map[hwid] = keyStr
	writeHwidMap(map)
end

local function clearHwidKey(hwid)
	local map = loadHwidMap()
	map[hwid] = nil
	writeHwidMap(map)
end

