-- Key validation
local function alphaIdx(ch)
	for i = 1, #ALPHABET do
		if string.sub(ALPHABET, i, i) == ch then
			return i - 1
		end
	end
	return nil
end

local function checkKey(raw)
	if type(raw) ~= "string" then return false, "Invalid key." end
	local k = string.upper(string.gsub(raw, "^%s*(.-)%s*$", "%1"))
	if k == "" then return false, DISCORD_INFO_EN end
	if k == string.upper(MASTER_PASS) then return true, "OK", k, "ADMIN", "LIFE" end

	local role, dur, p1, p2 = string.match(k, "^GLX%-([A-Z0-9]+)%-([A-Z0-9]+)%-([A-Z0-9]+)%-([A-Z0-9]+)$")
	if not role or not dur or not p1 or not p2 then
		return false, "Invalid format. " .. DISCORD_INFO_EN
	end
	if #p1 ~= 4 or #p2 < 2 then
		return false, "Incomplete key. " .. DISCORD_INFO_EN
	end

	local payload = role .. dur .. p1
	local sum = 0
	for i = 1, #payload do
		sum += string.byte(payload, i)
	end

	local expected = sum % #ALPHABET
	local actual = alphaIdx(string.sub(p2, 1, 1))
	if actual == nil or actual ~= expected then
		return false, "Wrong key. " .. DISCORD_INFO_EN
	end
	return true, "OK", k, role, dur
end

