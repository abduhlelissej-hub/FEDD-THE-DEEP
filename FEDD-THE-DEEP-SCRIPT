local function makeFrame(parent, size, pos, bg, radius, strokeCol, zIndex)
	local f = Instance.new("Frame")
	f.Size = size
	f.Position = pos
	f.BackgroundColor3 = bg
	f.BorderSizePixel = 0
	f.ZIndex = zIndex or 2
	f.Parent = parent

	if radius and radius > 0 then
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(0, radius)
		c.Parent = f
	end

	if strokeCol then
		local s = Instance.new("UIStroke")
		s.Thickness = 1.2
		s.Color = strokeCol
		s.Transparency = 0.25
		s.Parent = f
	end
	return f
end

local function makeBtn(parent, size, pos, bg, fg, textSize, txt, zIndex)
	local b = Instance.new("TextButton")
	b.Size = size
	b.Position = pos
	b.BackgroundColor3 = bg
	b.TextColor3 = fg
	b.Font = Enum.Font.FredokaOne
	b.TextSize = textSize
	b.Text = txt
	b.AutoButtonColor = false
	b.BorderSizePixel = 0
	b.ZIndex = zIndex or 3
	b.Parent = parent

	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 8)
	c.Parent = b

	local st = Instance.new("UIStroke")
	st.Thickness = 1
	st.Color = COL_ACCENT_PINK
	st.Transparency = 0.72
	st.Parent = b

	b.MouseEnter:Connect(function()
		st.Transparency = 0.2
		TweenService:Create(b, TweenInfo.new(0.12), {
			BackgroundColor3 = bg:Lerp(Color3.fromRGB(255, 255, 255), 0.1)
		}):Play()
	end)

	b.MouseLeave:Connect(function()
		st.Transparency = 0.72
		TweenService:Create(b, TweenInfo.new(0.12), {
			BackgroundColor3 = bg
		}):Play()
	end)

	return b
end

