-- Visual tap marker
local function showTapMarker(x, y)
	local marker = Instance.new("Frame")
	marker.Size = UDim2.new(0, 34, 0, 34)
	marker.Position = UDim2.new(0, x - 17, 0, y - 17)
	marker.BackgroundColor3 = COL_ACCENT_PINK
	marker.BackgroundTransparency = 0.25
	marker.BorderSizePixel = 0
	marker.ZIndex = 2000
	marker.Parent = screenGui

	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(1, 0)
	c.Parent = marker

	task.delay(0.35, function()
		if marker and marker.Parent then
			marker:Destroy()
		end
	end)
end

local function clickAtScreenPos(x, y)
	local tapX = math.floor(x)
	local tapY = math.floor(y)

	showTapMarker(tapX, tapY)

	pcall(function()
		VirtualInputManager:SendMouseButtonEvent(tapX, tapY, 0, true, game, 1)
		task.wait(0.05)
		VirtualInputManager:SendMouseButtonEvent(tapX, tapY, 0, false, game, 1)
	end)
end

local function tapScreen()
	local camera = workspace.CurrentCamera
	local viewport = camera and camera.ViewportSize or Vector2.new(1280, 720)
	clickAtScreenPos(viewport.X * 0.5, viewport.Y * 0.5)
end

-- EquipBest every 3 minutes (180s)
local function getEquipLeft()
	local left = EQUIP_COOLDOWN - (os.clock() - lastEquipTime)
	if left < 0 then return 0 end
	return math.ceil(left)
end

local function triggerEquipBest()
	if getEquipLeft() > 0 then
		return false
	end

	local aquariumPanel = playerGui:FindFirstChild("AquariumPanel")
	local holder = aquariumPanel and aquariumPanel:FindFirstChild("Holder")
	local equipTarget = holder and holder:FindFirstChild("EquipBest")

	lastEquipTime = os.clock()

	if equipTarget and equipTarget:IsA("GuiObject") and equipTarget.Visible then
		local absPos = equipTarget.AbsolutePosition
		local absSize = equipTarget.AbsoluteSize
		local inset = GuiService:GetGuiInset()

		local centerX = absPos.X + (absSize.X * 0.5) + inset.X
		local centerY = absPos.Y + (absSize.Y * 0.5) + inset.Y

		clickAtScreenPos(centerX, centerY)
	end
	return true
end

